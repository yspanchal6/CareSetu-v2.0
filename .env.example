# ============================================================
# CARESETU MASTER ENVIRONMENT CONFIGURATION TEMPLATE (.env.example)
# ============================================================

# ------------------------------------------------------------
# 1. CORE SERVER & ENVIRONMENT
# ------------------------------------------------------------
NODE_ENV="development"
PORT=3000
FRONTEND_URL="http://localhost:5173"
CORS_ORIGINS="http://localhost:5173,http://localhost:3000"

# ------------------------------------------------------------
# 2. DATABASE & ORM CONFIGURATION (PostgreSQL + PostGIS)
# ------------------------------------------------------------
DATABASE_URL="postgresql://postgres:postgres_password@localhost:5432/caresetu?schema=public"
# DIRECT_URL is optional if using Prisma Accelerate or connection poolers (PgBouncer)
# DIRECT_URL="postgresql://postgres:postgres_password@localhost:5432/caresetu?schema=public"

# ------------------------------------------------------------
# 3. SECURITY, JWT & ENCRYPTION KEYS
# ------------------------------------------------------------
# Must be at least 32 characters in production
JWT_SECRET="replace-with-a-32-character-random-jwt-secret-string"
HEALTH_PACK_KEY="replace-with-a-32-byte-hex-or-string-encryption-key"

# ------------------------------------------------------------
# 4. SMS PROVIDER CONFIGURATION (TextBee)
# ------------------------------------------------------------
TEXTBEE_API_KEY="your-textbee-api-key"
TEXTBEE_DEVICE_ID="your-textbee-device-id"
TEXTBEE_BASE_URL="https://api.textbee.dev"

# ------------------------------------------------------------
# 5. EMAIL PROVIDER CONFIGURATION (Brevo / Sendinblue)
# ------------------------------------------------------------
BREVO_API_KEY="xkeysib-your-brevo-api-key"
BREVO_SENDER_EMAIL="noreply@caresetu.com"
BREVO_SENDER_NAME="CareSetu Health Platform"

# ------------------------------------------------------------
# 6. FIREBASE ADMIN SERVICE ACCOUNT (Backend Push & Auth)
# ------------------------------------------------------------
FIREBASE_PROJECT_ID="caresetu-37de6"
FIREBASE_CLIENT_EMAIL="firebase-adminsdk-xxxxx@caresetu-37de6.iam.gserviceaccount.com"
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY_HERE\n-----END PRIVATE KEY-----\n"

# ------------------------------------------------------------
# 7. AI & DOCTOR AI ENGINE CONFIGURATION
# ------------------------------------------------------------
AI_SERVICE_URL=""
AI_API_KEY=""
AI_BASE_URL="https://api.openai.com/v1"
AI_MODEL="gpt-4o-mini"
AI_PROVIDER_TIMEOUT_MS=5000

# ------------------------------------------------------------
# 8. PUBLIC FRONTEND ENVIRONMENT VARIABLES (VITE_ PREFIX ONLY)
# ------------------------------------------------------------
VITE_API_URL="/api"
VITE_FIREBASE_API_KEY="your-firebase-web-api-key"
VITE_FIREBASE_AUTH_DOMAIN="caresetu-37de6.firebaseapp.com"
VITE_FIREBASE_PROJECT_ID="caresetu-37de6"
VITE_FIREBASE_STORAGE_BUCKET="caresetu-37de6.firebasestorage.app"
VITE_FIREBASE_MESSAGING_SENDER_ID="your-sender-id"
VITE_FIREBASE_APP_ID="your-firebase-app-id"
VITE_FIREBASE_VAPID_KEY="your-firebase-vapid-key"

# ------------------------------------------------------------
# 9. ENVIRONMENT MODE FLAGS
# ------------------------------------------------------------
# Set DEV_OTP_MODE=false in production
DEV_OTP_MODE=false

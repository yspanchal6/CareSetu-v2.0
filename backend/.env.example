# ============================================================
# CARESETU BACKEND ENVIRONMENT CONFIGURATION TEMPLATE
# ============================================================

NODE_ENV="development"
PORT=3000
FRONTEND_URL="http://localhost:5173"
CORS_ORIGINS="http://localhost:5173,http://localhost:3000"

# Database (Supabase pooler for DATABASE_URL, direct connection for migrations via DIRECT_URL)
DATABASE_URL="postgresql://postgres.[REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
DIRECT_URL="postgresql://postgres.[REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"

# Secrets (Minimum 32 bytes / 64 hex characters in production)
JWT_SECRET="replace-with-a-long-random-secret-key-at-least-32-chars"
HEALTH_PACK_KEY="replace-with-a-32-byte-encryption-key-for-healthpack"
URL_ENCRYPTION_SECRET="replace-with-a-32-byte-encryption-key-for-url-tokens"

# Cloudflare R2 Disaster Recovery Backups
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_NAME="caresetu-staging-backups"

# SMS (TextBee)
TEXTBEE_API_KEY=""
TEXTBEE_DEVICE_ID=""
TEXTBEE_BASE_URL="https://api.textbee.dev"

# Email (Brevo)
BREVO_API_KEY=""
BREVO_SENDER_EMAIL="caresetu@example.com"
BREVO_SENDER_NAME="CareSetu"

# Firebase Admin
FIREBASE_PROJECT_ID=""
FIREBASE_CLIENT_EMAIL=""
FIREBASE_PRIVATE_KEY=""

# AI Service
AI_SERVICE_URL=""
AI_API_KEY=""
AI_BASE_URL="https://api.openai.com/v1"
AI_MODEL="gpt-4o-mini"
AI_PROVIDER_TIMEOUT_MS=5000

# Dev flags
DEV_OTP_MODE=false